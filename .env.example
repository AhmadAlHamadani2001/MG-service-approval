# Copy this file to .env for local testing against a real database, or set
# these as environment variables in your hosting provider's dashboard
# (e.g. Render → your service → Environment).
#
# Neither variable is required for local development: with both unset,
# `npm start` runs exactly as it always has (local server/data.json file,
# a built-in demo JWT secret). Set both before deploying for real use.

# Postgres connection string (e.g. from Supabase: Project Settings ->
# Database -> Connection string -> "Session pooler", which supports IPv4 —
# most hosts, including Render's free tier, cannot reach Supabase's direct
# IPv6-only host). When unset, the app falls back to a local JSON file.
DATABASE_URL=

# Long random secret used to sign login sessions. Generate one with:
#   openssl rand -hex 32
# Required in production (NODE_ENV=production) — the app refuses to start
# without it rather than silently using the demo default.
JWT_SECRET=

# Most hosts (including Render) set this automatically — only set it
# yourself for local testing of the production-mode JWT_SECRET check.
NODE_ENV=

# Only needed if your host doesn't set $PORT itself.
PORT=4000
